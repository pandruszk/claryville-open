<% layout('layout') -%>
<div class="admin-header">
  <h1>Inbox</h1>
  <form method="POST" action="/admin/inbox/poll" class="form-inline">
    <input type="hidden" name="_csrf" value="<%= locals.csrfToken || "" %>">
    <button type="submit" class="btn btn-small">Check for New Emails</button>
  </form>
</div>

<nav class="admin-nav">
  <a href="/admin">Dashboard</a>
  <a href="/admin/groups">Groups</a>
  <a href="/admin/inbox" class="active">Inbox</a>
  <a href="/admin/email">Email</a>
  <a href="/admin/contacts">Contacts</a>
  <a href="/admin/scores">Scores</a>
  <a href="/admin/gallery">Gallery</a>
  <a href="/admin/rules-suggestions">Rules</a>
  <a href="/admin/past-winners">Winners</a>
  <a href="/admin/chat-log">Chat Log</a>
  <a href="/admin/careers">Careers</a>
</nav>

<div class="draft-stats-bar">
  <span class="draft-stat"><strong><%= draftStats.pending %></strong> pending drafts</span>
  <span class="draft-stat"><strong><%= draftStats.needsReview %></strong> needs review</span>
  <span class="draft-stat"><strong><%= draftStats.ruleSuggestions %></strong> rule suggestions</span>
  <span class="draft-stat"><strong><%= typeof pendingActionsCount !== 'undefined' ? pendingActionsCount : 0 %></strong> proposed actions</span>
  <span class="draft-stat"><strong><%= draftStats.sent %></strong> sent</span>
</div>

<% if (messages.length > 0) { %>
  <table class="admin-table" style="table-layout:fixed;width:100%">
    <thead>
      <tr>
        <th style="width:60px">Status</th>
        <th style="width:22%">From</th>
        <th style="width:22%">Subject</th>
        <th style="width:80px">Received</th>
        <th style="width:130px">AI Draft</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% for (const msg of messages) { %>
        <tr class="<%= msg.processed ? 'processed' : 'unprocessed' %>">
          <td><span class="badge <%= msg.processed ? 'badge-complete' : 'badge-looking' %>"><%= msg.processed ? 'Done' : 'New' %></span></td>
          <td style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="<%= msg.from_addr %>"><%= msg.from_addr %></td>
          <td style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="<%= msg.subject %>"><%= msg.subject %></td>
          <td><%= new Date(msg.received_at).toLocaleDateString() %></td>
          <td>
            <% if (msg.draft) { %>
              <% if (msg.draft.status === 'pending') { %>
                <a href="/admin/inbox/<%= msg.id %>/draft" class="btn btn-small btn-primary">Review Draft</a>
                <% if (msg.draft.needs_review) { %>
                  <span class="badge badge-needs-review">Needs Review</span>
                <% } %>
                <% if (msg.draft.is_rule_suggestion) { %>
                  <span class="badge badge-rule">Rule Suggestion</span>
                <% } %>
              <% } else if (msg.draft.status === 'sent') { %>
                <span class="badge badge-complete">Sent</span>
              <% } else if (msg.draft.status === 'dismissed') { %>
                <span class="badge badge-dismissed">Dismissed</span>
              <% } %>
            <% } else { %>
              <span class="badge badge-nodraft">No Draft</span>
            <% } %>
          </td>
          <td class="actions">
            <button class="btn btn-small" onclick="toggleBody(<%= msg.id %>)">View</button>
            <a href="/admin/inbox/<%= msg.id %>/draft" class="btn btn-small">Reply</a>
            <% if ((msg.pendingActions || []).length > 0) { %>
              <button class="btn btn-small btn-primary" onclick="toggleActions(<%= msg.id %>)">
                AI proposals (<%= msg.pendingActions.length %>)
              </button>
            <% } else { %>
              <form method="POST" action="/admin/inbox/<%= msg.id %>/extract-actions" class="form-inline">
                <input type="hidden" name="_csrf" value="<%= locals.csrfToken || "" %>">
                <button type="submit" class="btn btn-small">Suggest contacts</button>
              </form>
            <% } %>
            <% if (!msg.processed) { %>
              <form method="POST" action="/admin/inbox/<%= msg.id %>/process" class="form-inline">
                <input type="hidden" name="_csrf" value="<%= locals.csrfToken || "" %>">
                <button type="submit" class="btn btn-small">Mark Done</button>
              </form>
            <% } %>
            <form method="POST" action="/admin/inbox/<%= msg.id %>/delete" class="form-inline" onsubmit="return confirm('Delete?')">
              <input type="hidden" name="_csrf" value="<%= locals.csrfToken || "" %>">
              <button type="submit" class="btn btn-small btn-danger">Delete</button>
            </form>
          </td>
        </tr>
        <tr id="body-<%= msg.id %>" class="email-body-row" style="display:none">
          <td colspan="6"><pre class="email-body"><%= msg.body %></pre></td>
        </tr>
        <% if ((msg.pendingActions || []).length > 0) { %>
          <tr id="actions-<%= msg.id %>">
            <td colspan="6" style="background:#fafafa;padding:0.85rem 1rem">
              <strong style="font-size:0.9rem;display:block;margin-bottom:0.5rem">AI proposed actions — review before approving</strong>
              <% for (const a of msg.pendingActions) { %>
                <div style="display:flex;flex-wrap:wrap;gap:0.5rem;align-items:center;padding:0.4rem 0;border-top:1px solid #eee">
                  <% if (a.action_type === 'add_contact') { %>
                    <span style="flex:1 1 auto">
                      <strong>Add contact:</strong>
                      <%= a.payload.first_name || '' %> <%= a.payload.last_name || '' %>
                      &lt;<%= a.payload.email %>&gt;
                      <% if (a.payload.clan) { %><span style="color:#6b7280">· clan: <%= a.payload.clan %></span><% } %>
                      <% if (a.payload.rules_committee) { %><span class="badge badge-rule">rules committee</span><% } %>
                      <% if (a.rationale) { %>
                        <div style="color:#6b7280;font-size:0.85rem;margin-top:0.15rem"><%= a.rationale %></div>
                      <% } %>
                    </span>
                  <% } else { %>
                    <span style="flex:1 1 auto"><%= a.action_type %>: <%= a.payload_json %></span>
                  <% } %>
                  <form method="POST" action="/admin/actions/<%= a.id %>/approve" class="form-inline">
                    <input type="hidden" name="_csrf" value="<%= locals.csrfToken || "" %>">
                    <button type="submit" class="btn btn-small btn-primary">Approve</button>
                  </form>
                  <form method="POST" action="/admin/actions/<%= a.id %>/reject" class="form-inline">
                    <input type="hidden" name="_csrf" value="<%= locals.csrfToken || "" %>">
                    <button type="submit" class="btn btn-small">Reject</button>
                  </form>
                </div>
              <% } %>
            </td>
          </tr>
        <% } %>
      <% } %>
    </tbody>
  </table>
<% } %>

<script>
function toggleBody(id) {
  const row = document.getElementById('body-' + id);
  row.style.display = row.style.display === 'none' ? 'table-row' : 'none';
}
function toggleActions(id) {
  const row = document.getElementById('actions-' + id);
  if (row) row.style.display = row.style.display === 'none' ? 'table-row' : 'none';
}
</script>
