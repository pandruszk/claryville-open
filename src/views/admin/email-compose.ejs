<% layout('layout') -%>
<div class="admin-header">
  <h1>Email Campaigns</h1>
</div>

<nav class="admin-nav">
  <a href="/admin">Dashboard</a>
  <a href="/admin/groups">Groups</a>
  <a href="/admin/inbox">Inbox</a>
  <a href="/admin/email" class="active">Email</a>
  <a href="/admin/contacts">Contacts</a>
  <a href="/admin/scores">Scores</a>
  <a href="/admin/gallery">Gallery</a>
  <a href="/admin/rules-suggestions">Rules</a>
  <a href="/admin/past-winners">Winners</a>
  <a href="/admin/chat-log">Chat Log</a>
  <a href="/admin/careers">Careers</a>
</nav>

<section class="admin-section">
  <h2>Compose Email</h2>

  <div class="ai-draft-section" style="margin-bottom: 1.25rem; padding: 0.85rem 1rem; background: var(--gray-50, #f5f5f5); border: 1px solid var(--gray-200, #e5e5e5); border-radius: 8px;">
    <strong style="display:block;margin-bottom:0.35rem">Draft from notes</strong>
    <p class="form-hint" style="margin:0 0 0.5rem 0">Paste an idea, a forwarded email, or a few bullet points. The AI fills in the subject and body for you to edit.</p>
    <textarea id="ai-notes" rows="4" style="width:100%;font-family:inherit" placeholder="e.g. Matt forwarded that the merch shop is open through June 1 — claryvillecountryclub.teecommerce.shop. Good moment to nudge people to register too."></textarea>
    <div style="margin-top:0.5rem;display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap">
      <button type="button" id="ai-generate-btn" class="btn btn-small btn-primary" onclick="generateFromNotes()">Generate</button>
      <span id="ai-generate-status" style="color:var(--gray-500, #6b7280);font-size:0.85rem"></span>
    </div>
  </div>

  <div class="email-templates">
    <strong>Quick templates:</strong>
    <button class="btn btn-small" onclick="loadTemplate('save-the-date')">Save the Date</button>
    <button class="btn btn-small" onclick="loadTemplate('registration-open')">Registration Open</button>
    <button class="btn btn-small" onclick="loadTemplate('groups-details')">Groups & Details</button>
    <button class="btn btn-small" onclick="loadTemplate('final-call')">Final Call</button>
    <button class="btn btn-small" onclick="loadTemplate('recap')">Recap & Results</button>
  </div>

  <form method="POST" action="/admin/email/send" class="form" onsubmit="return confirmSend()">
    <input type="hidden" name="_csrf" value="<%= locals.csrfToken || "" %>">
    <div class="form-group">
      <label for="audience">Audience</label>
      <select id="audience" name="audience" onchange="updateSendLabel()">
        <% for (const opt of audienceOptions) { %>
          <option value="<%= opt.value %>" data-count="<%= opt.count %>"><%= opt.label %></option>
        <% } %>
      </select>
    </div>
    <div class="form-group">
      <label for="subject">Subject</label>
      <input type="text" id="subject" name="subject" required>
    </div>
    <div class="form-group">
      <label for="body">Body (HTML)</label>
      <textarea id="body" name="body" rows="15" required></textarea>
    </div>
    <div class="form-group">
      <label>Preview</label>
      <div id="preview" class="email-preview"></div>
    </div>
    <div class="form-group">
      <label>Send time</label>
      <div style="display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap">
        <label style="display:inline-flex;align-items:center;gap:0.35rem;font-weight:normal;margin:0">
          <input type="radio" name="send_time" value="now" checked onchange="toggleScheduled()"> Now
        </label>
        <label style="display:inline-flex;align-items:center;gap:0.35rem;font-weight:normal;margin:0">
          <input type="radio" name="send_time" value="scheduled" onchange="toggleScheduled()"> Schedule for later
        </label>
        <input type="datetime-local" id="scheduled-at-display" disabled style="font-family:inherit">
        <input type="hidden" name="scheduled_at" id="scheduled-at-utc" value="">
        <span id="scheduled-tz-hint" style="color:var(--gray-500, #6b7280);font-size:0.85rem"></span>
      </div>
    </div>
    <button type="submit" class="btn btn-primary" id="send-btn">Send to All (<%= emailCount %>)</button>
  </form>
</section>

<% if (recentEvents && recentEvents.length > 0) { %>
  <section class="admin-section">
    <h2>Recent Activity</h2>
    <p class="form-hint" style="margin-top:0">Last 30 days:
      <strong><%= eventStats['email.delivered'] || 0 %></strong> delivered ·
      <strong><%= eventStats['email.opened'] || 0 %></strong> opens ·
      <strong><%= eventStats['email.clicked'] || 0 %></strong> clicks ·
      <strong><%= eventStats['email.bounced'] || 0 %></strong> bounces ·
      <strong><%= eventStats['email.complained'] || 0 %></strong> complaints
    </p>
    <table class="admin-table">
      <thead>
        <tr><th>When</th><th>Event</th><th>Recipient</th><th>Subject</th></tr>
      </thead>
      <tbody>
        <% for (const ev of recentEvents) { %>
          <% const label = (ev.event_type || '').replace('email.', '');
             const cls = label === 'opened' ? 'badge-complete'
                       : label === 'clicked' ? 'badge-complete'
                       : label === 'bounced' || label === 'complained' ? 'badge-needs-review'
                       : 'badge-draft-pending'; %>
          <tr>
            <td><%= new Date(ev.occurred_at).toLocaleString() %></td>
            <td><span class="badge <%= cls %>"><%= label %></span></td>
            <td><%= ev.recipient || '—' %></td>
            <td><%= ev.subject || '—' %></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </section>
<% } %>

<% if (sentEmails.length > 0) { %>
  <section class="admin-section">
    <h2>Sent Emails</h2>
    <table class="admin-table">
      <thead>
        <tr><th>Send time</th><th>Subject</th><th>Recipients</th></tr>
      </thead>
      <tbody>
        <% for (const e of sentEmails) { %>
          <% const scheduled = e.scheduled_at ? new Date(e.scheduled_at) : null;
             const queued = new Date(e.sent_at + (e.sent_at && !e.sent_at.endsWith('Z') ? 'Z' : ''));
             const isFuture = scheduled && scheduled.getTime() > Date.now(); %>
          <tr>
            <td>
              <% if (scheduled) { %>
                <span class="badge <%= isFuture ? 'badge-needs-review' : 'badge-complete' %>" style="margin-right:0.4rem"><%= isFuture ? 'Scheduled' : 'Sent' %></span>
                <%= scheduled.toLocaleString() %>
              <% } else { %>
                <%= queued.toLocaleString() %>
              <% } %>
            </td>
            <td><%= e.subject %></td>
            <td><%= e.recipient_count %></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </section>
<% } %>

<script>
const templates = {
  'save-the-date': {
    subject: 'The Claryville Open — Save the Date!',
    body: '<h1>The Claryville Open</h1>\n<p>Mark your calendars! The annual Claryville Open is coming up.</p>\n<p><strong>Date:</strong> Friday, July 3, 2026</p>\n<p><strong>Course:</strong> Tarry Brae Golf Course</p>\n<p>Registration opens soon. Stay tuned for more details!</p>'
  },
  'registration-open': {
    subject: 'The Claryville Open — Registration is Open!',
    body: '<h1>Registration is Open!</h1>\n<p>Sign up your foursome for the Claryville Open.</p>\n<p><a href="{{BASE_URL}}/register">Register here</a></p>\n<p>Don\'t have a full team? No problem — sign up solo and we\'ll help you find a group.</p>'
  },
  'groups-details': {
    subject: 'The Claryville Open — Groups & Details',
    body: '<h1>Groups Are Set!</h1>\n<p>Check out the current group assignments:</p>\n<p><a href="{{BASE_URL}}/groups">View Groups</a></p>\n<p>If you need to make changes, reply to this email or contact us.</p>'
  },
  'final-call': {
    subject: 'The Claryville Open — Final Call!',
    body: '<h1>Last Chance!</h1>\n<p>The tournament is almost here. This is your last chance to:</p>\n<ul>\n<li>Register or change your group</li>\n<li>Make a donation to the Fire Department</li>\n</ul>\n<p>See you on the course!</p>'
  },
  'recap': {
    subject: 'The Claryville Open — Results & Recap',
    body: '<h1>What a Tournament!</h1>\n<p>Thanks to everyone who came out for the Claryville Open.</p>\n<p><a href="{{BASE_URL}}/leaderboard">View the full leaderboard</a></p>\n<p>See you next year!</p>'
  }
};

function loadTemplate(name) {
  const t = templates[name];
  if (t) {
    document.getElementById('subject').value = t.subject;
    document.getElementById('body').value = t.body;
    updatePreview();
  }
}

function updatePreview() {
  document.getElementById('preview').innerHTML = document.getElementById('body').value;
}

document.getElementById('body')?.addEventListener('input', updatePreview);

function updateSendLabel() {
  const sel = document.getElementById('audience');
  const opt = sel.options[sel.selectedIndex];
  const sched = document.querySelector('input[name="send_time"]:checked')?.value === 'scheduled';
  document.getElementById('send-btn').textContent = (sched ? 'Schedule — ' : 'Send — ') + opt.textContent;
}

function toggleScheduled() {
  const isScheduled = document.querySelector('input[name="send_time"]:checked')?.value === 'scheduled';
  const display = document.getElementById('scheduled-at-display');
  const hint = document.getElementById('scheduled-tz-hint');
  display.disabled = !isScheduled;
  if (isScheduled && !display.value) {
    // Default: tomorrow at 9am in the browser's local timezone
    const d = new Date();
    d.setDate(d.getDate() + 1);
    d.setHours(9, 0, 0, 0);
    const pad = n => String(n).padStart(2, '0');
    display.value = d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate())
      + 'T' + pad(d.getHours()) + ':' + pad(d.getMinutes());
  }
  hint.textContent = isScheduled
    ? '(' + Intl.DateTimeFormat().resolvedOptions().timeZone + ')'
    : '';
  updateSendLabel();
}

function confirmSend() {
  const sel = document.getElementById('audience');
  const opt = sel.options[sel.selectedIndex];
  const isScheduled = document.querySelector('input[name="send_time"]:checked')?.value === 'scheduled';
  const display = document.getElementById('scheduled-at-display');
  const hidden = document.getElementById('scheduled-at-utc');
  let timeText = 'now';
  if (isScheduled) {
    if (!display.value) { alert('Pick a date and time, or switch to Send now.'); return false; }
    const d = new Date(display.value); // datetime-local string — interpreted as browser-local
    if (isNaN(d.getTime())) { alert('That date/time is invalid.'); return false; }
    if (d.getTime() < Date.now() + 60000) { alert('Scheduled time must be at least a minute in the future.'); return false; }
    timeText = 'scheduled for ' + d.toLocaleString();
    hidden.value = d.toISOString(); // hidden field carries the UTC ISO to the server
  } else {
    hidden.value = '';
  }
  return confirm('Send to ' + opt.textContent + ' — ' + timeText + '?');
}

// Initialize label on page load in case the selected option isn't the default
updateSendLabel();

async function generateFromNotes() {
  const notes = document.getElementById('ai-notes').value.trim();
  const status = document.getElementById('ai-generate-status');
  const btn = document.getElementById('ai-generate-btn');
  if (!notes) { status.textContent = 'Paste some notes first.'; return; }

  btn.disabled = true;
  status.textContent = 'Drafting…';
  const csrf = document.querySelector('input[name="_csrf"]').value;

  try {
    const resp = await fetch('/admin/email/generate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf },
      body: JSON.stringify({ notes })
    });
    if (!resp.ok) {
      const text = await resp.text();
      throw new Error(text || ('HTTP ' + resp.status));
    }
    const { subject, body_html } = await resp.json();
    document.getElementById('subject').value = subject || '';
    document.getElementById('body').value = body_html || '';
    updatePreview();
    status.textContent = 'Drafted. Edit subject/body, pick audience, then send.';
  } catch (err) {
    status.textContent = 'Error: ' + err.message;
  } finally {
    btn.disabled = false;
  }
}
</script>
