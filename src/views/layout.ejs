<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' — ' : '' %>The Claryville Open</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@700;800;900&display=swap" rel="stylesheet">
  <link rel="icon" href="/favicon.ico">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="stylesheet" href="/css/style.css">
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-R0J23BVR6X"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-R0J23BVR6X');
  </script>
</head>
<body>
  <nav class="navbar">
    <div class="nav-inner">
      <a href="/" class="nav-brand">
        <img src="/media/logo.png" alt="Claryville Open" class="brand-logo">
      </a>
      <button class="nav-toggle" aria-label="Toggle navigation">&#9776;</button>
      <ul class="nav-links">
        <li><a href="/register">Register</a></li>
        <li><a href="https://claryvillecountryclub.teecommerce.shop" target="_blank" rel="noopener">Buy Merch</a></li>
        <li class="nav-dropdown">
          <a href="#" class="nav-dropdown-toggle">About <span class="dropdown-arrow">&#9662;</span></a>
          <ul class="nav-dropdown-menu">
            <li><a href="/groups">Groups</a></li>
            <li><a href="/rules">Rules</a></li>
            <li><a href="/past-winners">Past Winners</a></li>
            <li><a href="/gallery">Gallery</a></li>
            <li><a href="/leaderboard">Leaderboard</a></li>
            <li><a href="/questions">Questions</a></li>
          </ul>
        </li>
      </ul>
    </div>
  </nav>
  <div class="sub-header">
    <div class="sub-header-inner">
      <span class="sub-header-name">The Claryville Open</span>
      <span class="sub-header-details">Tarry Brae Golf Course &middot; Friday, July 3, 2026</span>
    </div>
  </div>
  <% if (locals.query && (locals.query.check_email || locals.query.subscribed || locals.query.subscribe_error)) { %>
    <div style="background:#f0f9ff;border-bottom:1px solid #bae6fd;padding:0.85rem 1rem;text-align:center;font-size:0.95rem;color:#0c4a6e">
      <% if (locals.query.check_email) { %>
        ✉️ Almost there! Check your email and click the confirmation link to finish subscribing.
      <% } else if (locals.query.subscribed) { %>
        ✅ You're on the list. Thanks for subscribing!
      <% } else if (locals.query.subscribe_error) { %>
        ⚠️ That didn't look like a valid email. Please try again.
      <% } %>
    </div>
  <% } %>
  <main>
    <%- body %>
  </main>
  <footer class="footer">
    <div class="footer-inner">
      <img src="/media/logo.png" alt="Claryville Open" class="footer-logo">
      <div class="footer-brand">The Claryville Open</div>
      <div class="footer-text">Annual Family Scramble Tournament &middot; Est. 1993</div>
      <div class="footer-links">
        <a href="/rules">Rules</a>
        <a href="/register">Register</a>
        <a href="/gallery">Gallery</a>
        <a href="/past-winners">Past Winners</a>
        <a href="/careers">Careers</a>
      </div>
      <div class="footer-signup">
        <p class="footer-signup-label">Stay in the loop</p>
        <form method="POST" action="/subscribe" class="footer-signup-form">
          <input type="hidden" name="_csrf" value="<%= locals.csrfToken || "" %>">
          <!-- honeypot: real users never see or fill this; bots usually do -->
          <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-10000px;width:1px;height:1px;opacity:0">
          <input type="email" name="email" placeholder="Your email address" required>
          <button type="submit" class="btn btn-accent btn-small">Sign Up</button>
        </form>
      </div>
      <div class="footer-copy">&copy; <%= new Date().getFullYear() %> The Claryville Open. All proceeds benefit the Claryville Fire Department.<br><a href="/admin" style="opacity:0.5;color:inherit;text-decoration:none">Admin</a></div>
    </div>
  </footer>
  <script src="/js/app.js"></script>
</body>
</html>
